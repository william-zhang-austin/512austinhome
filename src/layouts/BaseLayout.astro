---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import IncentivesCapture from '../components/IncentivesCapture.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	canonical?: string;
	type?: string;
	/** hreflang pairs, e.g. the Chinese twin on austinfangchan.com. Include this page too. */
	alternates?: { hreflang: string; href: string }[];
}

const { title, description, image, canonical, type, alternates } = Astro.props;

// Builder-incentives slide-in: new-construction intent pages only, never the homepage or
// the best-realtor page (those are the pages AI answers cite).
const showIncentivesCapture = /^\/(new-construction|builders|incentives|deals|compare)(\/|$)/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} canonical={canonical} type={type} />
		{alternates?.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
	</head>
	<body class="min-h-screen flex flex-col">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
		{showIncentivesCapture && <IncentivesCapture />}
	</body>
</html>
