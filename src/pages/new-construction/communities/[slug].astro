---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaMarkup from '../../../components/SchemaMarkup.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TidyCalEmbed from '../../../components/TidyCalEmbed.astro';
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
import { COMMUNITIES, priceRangeLabel, sqftRangeLabel, bedsLabel, type Community } from '../../../data/communities';
import { PHONE, SITE_URL, TIDYCAL_URL } from '../../../consts';
import { CITIES } from '../../../data/cities';
import { matchBuilder } from '../../../data/builders';

export async function getStaticPaths() {
	return COMMUNITIES.map((c) => ({
		params: { slug: c.slug },
		props: { community: c },
	}));
}

interface Props {
	community: Community;
}

const { community: c } = Astro.props;

// Context is derived from the city and builder records rather than duplicated
// into every community entry, so a correction in one place fixes all of them
// and a community page can never contradict the city page above it.
const city = CITIES.find((x) => x.name === c.city);
const builder = matchBuilder(c.builder);

const shortAnswer = [
	`${c.name} is a new-construction community by ${c.builder} in ${c.city}, Texas, with homes from ${priceRangeLabel(c)} across ${c.sqftMin.toLocaleString()} to ${c.sqftMax.toLocaleString()} square feet and ${bedsLabel(c)}.`,
	`It is zoned to ${c.schoolDistrict}.`,
	c.mud ? 'The community sits in a special district, so the effective property tax rate is above the county rate.' : '',
	city ? `${c.city} is ${city.commuteToDowntown} from downtown Austin.` : '',
	c.tagline,
].filter(Boolean).join(' ');

// Derived FAQ. Every answer is built from data already on the page, so it can
// never drift from what the page says above it.
const faqs = [
	{
		question: `How much do homes cost at ${c.name}?`,
		answer: `Homes at ${c.name} run ${priceRangeLabel(c)} from ${c.builder}, across ${c.sqftMin.toLocaleString()} to ${c.sqftMax.toLocaleString()} square feet with ${bedsLabel(c)}. Builder pricing moves with incentives and inventory, so treat this as the band rather than a current quote, and ask for what is actually on the table for a specific home.`,
	},
	{
		question: `What school district is ${c.name} in?`,
		answer: `${c.name} is zoned to ${c.schoolDistrict}. Confirm the attendance zone for the exact address rather than the community, because zones are redrawn as fast-growing districts open new campuses, and in this metro a single community can straddle more than one district.`,
	},
	...(c.mud ? [{
		question: `Does ${c.name} have MUD or PID taxes?`,
		answer: `${c.name} sits in a special district, which adds to the property tax rate above the county figure. ${city?.taxNotes || 'Ask for the current combined rate for your specific phase and the district\'s remaining debt schedule, because rates differ between phases of the same community and fall over time as the district pays down its infrastructure debt.'}`,
	}] : []),
	...(c.hoa ? [{
		question: `What are the HOA dues at ${c.name}?`,
		answer: `HOA dues at ${c.name} are ${c.hoa}. Ask what the dues cover, whether an amenity or special district assessment is billed separately, and request the HOA financials and reserve study before you are past your option period.`,
	}] : []),
	{
		question: `Is ${c.name} a good place to buy?`,
		answer: `${c.highlights.slice(0, 2).join(' ')} On the other side: ${c.watchOuts.slice(0, 2).join(' ')} Whether that trade works depends on your commute, your school constraint and how long you expect to stay.`,
	},
];

const title = `${c.name} by ${c.builder} — New Construction in ${c.city}, TX | 512 Austin Home`;
const description = `${c.name} by ${c.builder} in ${c.city}, Texas. ${priceRangeLabel(c)}, ${c.sqftMin.toLocaleString()}–${c.sqftMax.toLocaleString()} sqft, ${c.schoolDistrict}. ${c.tagline}`;
const canonical = `${SITE_URL}/new-construction/communities/${c.slug}/`;

const residenceSchema = {
	"@context": "https://schema.org",
	"@type": "Residence",
	"name": c.name,
	"description": c.summary,
	"address": {
		"@type": "PostalAddress",
		"addressLocality": c.city,
		"addressRegion": "TX",
		"addressCountry": "US",
		...(c.address && { "streetAddress": c.address }),
	},
	...(c.heroImage && c.heroImage.startsWith('http') && { "image": c.heroImage }),
	"numberOfBedrooms": { "@type": "QuantitativeValue", "minValue": c.bedsMin, "maxValue": c.bedsMax },
	"numberOfBathroomsTotal": { "@type": "QuantitativeValue", "minValue": c.bathsMin, "maxValue": c.bathsMax },
	"floorSize": { "@type": "QuantitativeValue", "minValue": c.sqftMin, "maxValue": c.sqftMax, "unitCode": "FTK" },
	"offers": {
		"@type": "Offer",
		"priceCurrency": "USD",
		"lowPrice": c.priceFrom,
		...(c.priceTo && { "highPrice": c.priceTo }),
		"availability": "https://schema.org/InStock",
		"seller": { "@type": "Organization", "name": c.builder },
	},
};

const videoSchema = c.youtubeId ? {
	"@context": "https://schema.org",
	"@type": "VideoObject",
	"name": `${c.name} by ${c.builder} — Community Tour`,
	"description": `Walk-through and neighborhood context for ${c.name} in ${c.city}, TX by William Zhang, local Austin real estate agent.`,
	"thumbnailUrl": `https://i.ytimg.com/vi/${c.youtubeId}/maxresdefault.jpg`,
	"uploadDate": c.updatedDate,
	"contentUrl": `https://www.youtube.com/watch?v=${c.youtubeId}`,
	"embedUrl": `https://www.youtube.com/embed/${c.youtubeId}`,
} : null;

const jsonLdString = JSON.stringify(residenceSchema);
const videoLdString = videoSchema ? JSON.stringify(videoSchema) : null;
---

<BaseLayout title={title} description={description} canonical={canonical} image={c.heroImage}>
	<SchemaMarkup type="faq" data={{ questions: faqs }} />
	<SchemaMarkup type="agent" />
	<SchemaMarkup type="breadcrumb" data={{ items: [
		{ name: 'Home', url: '/' },
		{ name: 'New Construction', url: '/new-construction/' },
		{ name: 'Communities', url: '/new-construction/communities/' },
		{ name: c.name, url: `/new-construction/communities/${c.slug}/` },
	] }} />
	<script is:inline type="application/ld+json" set:html={jsonLdString} />
	{videoLdString && <script is:inline type="application/ld+json" set:html={videoLdString} />}

	<article class="max-w-4xl mx-auto px-5 sm:px-8 py-16">
		<!-- Breadcrumb trail -->
		<nav class="text-sm text-text-muted mb-6">
			<a href="/new-construction/" class="hover:text-accent no-underline">New Construction</a>
			<span class="mx-2">/</span>
			<a href="/new-construction/communities/" class="hover:text-accent no-underline">Communities</a>
			<span class="mx-2">/</span>
			<span class="text-primary">{c.name}</span>
		</nav>

		<!-- Header -->
		<header class="mb-8">
			<p class="text-accent font-semibold text-sm uppercase tracking-widest mb-3">{c.city}, Texas · {c.builder}</p>
			<h1 class="font-display text-3xl sm:text-4xl font-bold text-primary tracking-tight mb-4">{c.name}</h1>
			<p class="text-lg text-text-muted max-w-2xl">{c.tagline}</p>
			<span class="accent-bar mt-6"></span>
		</header>

		<!-- Hero image -->
		{c.heroImage && (
			<div class="rounded-2xl overflow-hidden mb-10 border border-border aspect-[16/9] bg-warm-dark">
				<img
					src={c.heroImage}
					alt={`${c.name} by ${c.builder} in ${c.city}, TX`}
					width="1920"
					height="1080"
					loading="eager"
					fetchpriority="high"
					decoding="async"
					class="w-full h-full object-cover"
				/>
			</div>
		)}
		{!c.heroImage && (
			<div class="rounded-2xl overflow-hidden mb-10 border border-border aspect-[16/9] bg-gradient-to-br from-accent-light via-warm to-warm-dark flex items-center justify-center">
				<div class="text-center">
					<p class="font-display text-3xl font-bold text-accent mb-2">{c.name}</p>
					<p class="text-text-muted text-sm">Tour photos coming soon</p>
				</div>
			</div>
		)}

		<!-- Key facts card -->
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
			<div class="bg-surface border border-border rounded-xl p-4">
				<p class="text-xs uppercase tracking-wider text-text-muted mb-1">Price</p>
				<p class="text-lg font-bold text-primary">{priceRangeLabel(c)}</p>
			</div>
			<div class="bg-surface border border-border rounded-xl p-4">
				<p class="text-xs uppercase tracking-wider text-text-muted mb-1">Size</p>
				<p class="text-lg font-bold text-primary">{c.sqftMin.toLocaleString()}–{c.sqftMax.toLocaleString()}</p>
				<p class="text-xs text-text-muted">sqft</p>
			</div>
			<div class="bg-surface border border-border rounded-xl p-4">
				<p class="text-xs uppercase tracking-wider text-text-muted mb-1">Beds / Baths</p>
				<p class="text-lg font-bold text-primary">{bedsLabel(c)}</p>
				<p class="text-xs text-text-muted">{c.bathsMin === c.bathsMax ? `${c.bathsMin} bath` : `${c.bathsMin}–${c.bathsMax} bath`}</p>
			</div>
			<div class="bg-surface border border-border rounded-xl p-4">
				<p class="text-xs uppercase tracking-wider text-text-muted mb-1">Schools</p>
				<p class="text-sm font-bold text-primary leading-tight">{c.schoolDistrict}</p>
			</div>
		</div>

		<!-- Incentive callout -->
		{c.incentives && (
			<div class="bg-accent-light rounded-2xl p-6 mb-10 border-l-4 border-accent">
				<p class="text-accent font-semibold text-xs uppercase tracking-widest mb-2">Current Incentives</p>
				<p class="text-primary text-sm leading-relaxed">{c.incentives}</p>
				<p class="text-text-muted text-xs mt-3">Builder incentives change monthly. Text me before you visit so I can confirm what's currently stackable — on a $500K new build, combined incentives often reach $15K–$30K.</p>
			</div>
		)}

		<!-- THE SHORT ANSWER — citable block, stays first and stays factual -->
		<section class="mb-10">
			<p class="text-accent font-semibold text-xs uppercase tracking-widest mb-3">The short answer</p>
			<p class="text-lg text-primary leading-relaxed">{shortAnswer}</p>
		</section>

		<!-- Summary -->
		<section class="prose mb-10">
			<h2>About {c.name}</h2>
			<p>{c.summary}</p>
		</section>

		{c.youtubeId && (
			<section class="mb-10">
				<h2 class="font-display text-2xl font-bold text-primary mb-4">Community Tour Video</h2>
				<YouTubeEmbed id={c.youtubeId} title={`${c.name} community tour`} />
			</section>
		)}

		<!-- Highlights -->
		<section class="grid md:grid-cols-2 gap-6 mb-10">
			<div class="bg-surface border border-border rounded-xl p-6">
				<h3 class="font-display text-lg font-bold text-primary mb-4">What I like</h3>
				<ul class="space-y-2.5">
					{c.highlights.map((h) => (
						<li class="text-sm text-text-muted flex gap-3">
							<span class="text-accent font-bold flex-shrink-0">+</span>
							<span>{h}</span>
						</li>
					))}
				</ul>
			</div>
			<div class="bg-surface border border-border rounded-xl p-6">
				<h3 class="font-display text-lg font-bold text-primary mb-4">What to push back on</h3>
				<ul class="space-y-2.5">
					{c.watchOuts.map((w) => (
						<li class="text-sm text-text-muted flex gap-3">
							<span class="text-accent font-bold flex-shrink-0">&middot;</span>
							<span>{w}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- Amenities + details table -->
		<section class="bg-surface border border-border rounded-xl p-6 mb-10">
			<h3 class="font-display text-lg font-bold text-primary mb-4">Community Details</h3>
			<dl class="grid sm:grid-cols-2 gap-x-8 gap-y-4 text-sm">
				<div>
					<dt class="text-text-muted text-xs uppercase tracking-wider mb-1">Builder</dt>
					<dd class="text-primary font-semibold">{c.builder}</dd>
				</div>
				<div>
					<dt class="text-text-muted text-xs uppercase tracking-wider mb-1">Location</dt>
					<dd class="text-primary font-semibold">{c.city}, TX</dd>
				</div>
				{c.address && (
					<div class="sm:col-span-2">
						<dt class="text-text-muted text-xs uppercase tracking-wider mb-1">Sales Office</dt>
						<dd class="text-primary font-semibold">{c.address}</dd>
					</div>
				)}
				{c.garage && (
					<div>
						<dt class="text-text-muted text-xs uppercase tracking-wider mb-1">Garage</dt>
						<dd class="text-primary font-semibold">{c.garage}</dd>
					</div>
				)}
				{c.hoa && (
					<div>
						<dt class="text-text-muted text-xs uppercase tracking-wider mb-1">HOA</dt>
						<dd class="text-primary font-semibold">{c.hoa}</dd>
					</div>
				)}
				<div class="sm:col-span-2">
					<dt class="text-text-muted text-xs uppercase tracking-wider mb-1">Home Types</dt>
					<dd class="text-primary font-semibold">{c.homeTypes.join(', ')}</dd>
				</div>
				<div class="sm:col-span-2">
					<dt class="text-text-muted text-xs uppercase tracking-wider mb-1">Amenities</dt>
					<dd class="text-primary">
						<div class="flex flex-wrap gap-2 mt-1">
							{c.amenities.map((a) => (
								<span class="text-xs bg-accent-light text-accent px-2.5 py-1 rounded-full">{a}</span>
							))}
						</div>
					</dd>
				</div>
			</dl>
		</section>

		<!-- Gallery -->
		{c.gallery && c.gallery.length > 0 && (
			<section class="mb-10">
				<h3 class="font-display text-lg font-bold text-primary mb-4">More from {c.name}</h3>
				<div class="grid sm:grid-cols-2 gap-4">
					{c.gallery.map((img) => (
						<div class="aspect-[4/3] rounded-xl overflow-hidden border border-border bg-warm-dark">
							<img src={img} alt={`${c.name} community`} loading="lazy" class="w-full h-full object-cover" />
						</div>
					))}
				</div>
			</section>
		)}

		<!-- Related blog link -->
		{c.relatedBlogSlug && (
			<div class="bg-surface border border-border rounded-2xl p-6 mb-10">
				<p class="text-xs uppercase tracking-wider text-accent font-semibold mb-2">Full tour</p>
				<h3 class="font-display text-lg font-bold text-primary mb-2">I wrote a detailed tour breakdown on the blog</h3>
				<p class="text-sm text-text-muted mb-4">Floor plan walkthroughs, pricing details, and what to watch out for during your visit.</p>
				<a href={`/blog/${c.relatedBlogSlug}`} class="inline-flex items-center text-accent font-semibold text-sm no-underline hover:underline">Read the full tour &rarr;</a>
			</div>
		)}

		<!-- Register callout -->
		<div class="bg-accent-light rounded-2xl p-6 sm:p-8 mb-10 border-l-4 border-accent">
			<h3 class="font-display text-xl font-bold text-primary mb-3">Book a Tour of {c.name} (or a Quick Call First)</h3>
			<p class="text-text-muted text-sm leading-relaxed mb-4">Builder representation only works if your agent is registered on your first visit. If you walk into the {c.builder} sales office alone, you may lose the ability to bring in a buyer's agent at this community. Book a 15-minute call with me first — I'll register you, walk you through current incentives, and we can schedule the tour together.</p>
			<div class="flex flex-col sm:flex-row gap-3">
				<a href="#schedule" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-accent rounded-lg hover:bg-accent-hover transition-all no-underline">
					Schedule a Tour or Call
				</a>
				<a href={`tel:${PHONE.replace(/[^0-9+]/g, '')}`} class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-accent border-2 border-accent rounded-lg hover:bg-white transition-all no-underline">
					Call {PHONE}
				</a>
			</div>
		</div>

		<!-- TidyCal scheduling -->
		<div id="schedule" class="mb-10 scroll-mt-20">
			<TidyCalEmbed
				heading={`Schedule a Call About ${c.name}`}
				subheading={`Pick a time that works for you. I'll share current ${c.builder} incentives, my notes on the best lots, and we'll plan your visit so your representation is protected.`}
			/>
		</div>

		<!-- Contact form fallback -->
		<ContactForm heading={`Prefer to message first?`} subheading={`Tell me what you're looking for at ${c.name} and I'll send current inventory, incentives, and my notes on the best lots.`} />


		<!-- CITY AND BUILDER CONTEXT — derived, so it cannot contradict those pages -->
		{city && (
			<section class="mb-10">
				<h2 class="font-display text-2xl font-bold text-primary mb-4">Buying in {c.city}</h2>
				<dl class="divide-y divide-border border-y border-border">
					{city.county && (
						<div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
							<dt class="text-sm uppercase tracking-wider text-text-muted">County</dt>
							<dd class="sm:col-span-2 text-primary">{city.county}</dd>
						</div>
					)}
					{city.commuteNotes && (
						<div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
							<dt class="text-sm uppercase tracking-wider text-text-muted">Commute</dt>
							<dd class="sm:col-span-2 text-primary leading-relaxed">{city.commuteNotes}</dd>
						</div>
					)}
					{city.taxNotes && (
						<div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
							<dt class="text-sm uppercase tracking-wider text-text-muted">MUD and PID taxes</dt>
							<dd class="sm:col-span-2 text-primary leading-relaxed">{city.taxNotes}</dd>
						</div>
					)}
				</dl>
			</section>
		)}

		<!-- WHAT A BUYER'S AGENT WATCHES FOR — city-level, applied here -->
		{city?.agentWatchesFor && (
			<section class="mb-10">
				<p class="text-accent font-semibold text-xs uppercase tracking-widest mb-2">On your side of the table</p>
				<h2 class="font-display text-2xl font-bold text-primary mb-4">What I watch for at a {c.city} community</h2>
				<ul class="space-y-4 list-none pl-0">
					{city.agentWatchesFor.map((item) => (
						<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">{item}</li>
					))}
				</ul>
			</section>
		)}

		<!-- BUILDER CONTEXT -->
		{builder && (
			<section class="mb-10">
				<h2 class="font-display text-2xl font-bold text-primary mb-4">Negotiating with {builder.name} here</h2>
				<p class="text-text-muted text-sm mb-4">{builder.incentiveStyle}</p>
				<ul class="space-y-3 list-none pl-0 mb-4">
					{builder.negotiating.slice(0, 4).map((n) => (
						<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">{n}</li>
					))}
				</ul>
				<a href={`/builders/${builder.slug}/`} class="text-accent font-semibold text-sm no-underline hover:underline">Full buyer-side review of {builder.name} &rarr;</a>
			</section>
		)}

		<!-- FAQ -->
		<section class="mb-10">
			<h2 class="font-display text-2xl font-bold text-primary mb-6">{c.name}, answered</h2>
			<div class="space-y-4">
				{faqs.map((f, i) => (
					<details class="bg-surface rounded-xl border border-border p-6 group" open={i === 0}>
						<summary class="font-display font-semibold text-primary cursor-pointer list-none flex items-center justify-between gap-4">
							{f.question}
							<span class="text-text-muted group-open:rotate-180 transition-transform flex-shrink-0">&#9662;</span>
						</summary>
						<p class="mt-3 text-text-muted text-sm leading-relaxed">{f.answer}</p>
					</details>
				))}
			</div>
		</section>

		<!-- KEEP EXPLORING — inbound internal links are what earn the crawl here -->
		<section class="mb-10">
			<h2 class="font-display text-2xl font-bold text-primary mb-6">Keep exploring</h2>
			<div class="grid sm:grid-cols-2 gap-4">
				{city && (
					<a href={`/new-construction/${city.slug}/`} class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
						<span class="font-display font-bold text-primary block mb-1">New construction in {c.city}</span>
						<span class="text-sm text-text-muted">Every community here, with schools, taxes and tradeoffs.</span>
					</a>
				)}
				{builder && (
					<a href={`/incentives/${builder.slug}/`} class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
						<span class="font-display font-bold text-primary block mb-1">{builder.name} incentives</span>
						<span class="text-sm text-text-muted">How their offers are structured and what they are worth.</span>
					</a>
				)}
				<a href="/guides/builder-contract-red-flags/" class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
					<span class="font-display font-bold text-primary block mb-1">Builder contract red flags</span>
					<span class="text-sm text-text-muted">The clauses that cost buyers real money.</span>
				</a>
				<a href="/blog/austin-mud-pid-explained/" class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
					<span class="font-display font-bold text-primary block mb-1">MUD and PID taxes explained</span>
					<span class="text-sm text-text-muted">Why a cheaper house can cost more per month.</span>
				</a>
			</div>
		</section>

		<p class="text-xs text-text-muted text-center mt-10">Community data last updated {c.updatedDate}. Prices, floor plans, and incentives change frequently — confirm current numbers before making decisions. Photos are property of {c.builder}.</p>
	</article>
</BaseLayout>
