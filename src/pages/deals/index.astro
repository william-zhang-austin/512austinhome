---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import ContactForm from '../../components/ContactForm.astro';
import TidyCalEmbed from '../../components/TidyCalEmbed.astro';
import IncentiveDisclosure from '../../components/IncentiveDisclosure.astro';
import { PHONE } from '../../consts';
import { DEAL_PAGES, DEALS_PREMISE } from '../../data/deals';
import { CURRENT_OFFERS } from '../../data/current-offers';
import { BUILDERS } from '../../data/builders';
import { CITIES } from '../../data/cities';

const title = 'Austin New Construction Deals | What Is Actually Discounted | 512 Austin Home';
const description = 'Where the real deals are on Austin new construction: quick move-in homes, price reductions, and quarter-end timing. How builder discounts actually work, and how to tell a real deal from a marketed one.';

const faqs = [
	{
		question: 'How do I find the best deal on a new construction home in Austin?',
		answer: 'Look for a specific home under pressure rather than a community with a good advertised offer. The three reliable signals are a completed home that has been standing unsold for months, a builder approaching a quarter or year end, and a plan the builder has overbuilt. Ask the sales office which finished homes have been standing longest — they will usually tell you, and that is the whole conversation.',
	},
	{
		question: 'Why do builders give incentives instead of lowering the price?',
		answer: 'Because a recorded price cut becomes a comparable sale that lowers the value of every unsold home in the community, and of yours when you sell. An incentive does not appear in the sales price. That is why a builder who will not take $15,000 off will often find $15,000 in a buydown, closing cost contribution and design allowance. The money is the same to you and it is not the same to them.',
	},
	{
		question: 'Are advertised builder deals real?',
		answer: 'The advertised program is real and it applies to everyone, which is exactly why it is not where your advantage is. What is negotiable is what sits on top of it for one specific address, and that is rarely advertised at all. Broker bonuses on standing inventory are a good example: they are posted to agents rather than to buyers and can often be redirected to you.',
	},
	{
		question: 'How much can you actually save on Austin new construction?',
		answer: 'It varies enormously by builder, by community and by how long a specific home has been standing, which is why any page quoting a single number is guessing. The honest answer is that the range is wide enough to be worth a conversation about the specific home you are considering rather than a general figure.',
	},
];
---

<BaseLayout title={title} description={description}>
	<SchemaMarkup type="agent" />
	<SchemaMarkup type="faq" data={{ questions: faqs }} />
	<SchemaMarkup type="breadcrumb" data={{ items: [
		{ name: 'Home', url: '/' },
		{ name: 'Deals', url: '/deals/' },
	] }} />

	<div class="max-w-3xl mx-auto px-5 sm:px-8 py-16">
		<header class="mb-8">
			<h1 class="font-display text-3xl sm:text-5xl font-bold text-primary tracking-tight mb-4">Austin New Construction Deals</h1>
			<p class="text-lg text-text-muted">What is actually discounted, and how to tell that from what is advertised</p>
		</header>

		<section class="mb-10">
			<p class="text-accent font-semibold text-xs uppercase tracking-widest mb-3">The short answer</p>
			<p class="text-lg text-primary leading-relaxed">{DEALS_PREMISE}</p>
		</section>

		<IncentiveDisclosure />

		<section class="mb-16">
			<h2 class="font-display text-2xl font-bold text-primary mb-6">What is on the table right now</h2>
			{CURRENT_OFFERS.length > 0 ? (
				<div class="space-y-4">
					{CURRENT_OFFERS.map((o) => {
						const b = BUILDERS.find((x) => x.slug === o.builderSlug);
						return (
							<div class="bg-surface border border-border rounded-xl p-6">
								{b && <a href={`/incentives/${b.slug}/`} class="font-display text-base font-bold text-accent no-underline hover:underline">{b.name}</a>}
								<p class="font-display text-lg font-bold text-primary mt-1 mb-2">{o.headline}</p>
								{o.detail && <p class="text-sm text-text-muted leading-relaxed mb-3">{o.detail}</p>}
								{o.communities && o.communities.length > 0 && (
									<p class="text-sm text-text-muted mb-3"><strong class="text-primary">Where:</strong> {o.communities.join(', ')}</p>
								)}
								<p class="text-xs text-text-muted">Confirmed {o.verifiedOn} · {o.source}</p>
							</div>
						);
					})}
				</div>
			) : (
				<div class="bg-surface border border-border rounded-xl p-6">
					<p class="text-sm text-text-muted leading-relaxed">I do not have confirmed offers on file this week, and I would rather show you nothing than something I have not verified myself. Tell me your budget and the areas you are considering and I will call the builders directly, find out which homes are genuinely under pressure, and send you the short list. That is also how you hear about the concessions that never get advertised.</p>
				</div>
			)}
		</section>

		<section class="mb-16">
			<h2 class="font-display text-2xl font-bold text-primary mb-6">Where the deals are</h2>
			<div class="space-y-4">
				{DEAL_PAGES.map((d) => (
					<a href={`/deals/${d.slug}/`} class="block bg-surface border border-border rounded-xl p-6 no-underline hover:border-accent transition-colors group">
						<h3 class="font-display text-lg font-bold text-primary group-hover:text-accent transition-colors mb-1">{d.title}</h3>
						<p class="text-sm text-text-muted mb-2">{d.subtitle}</p>
						<p class="text-sm text-text-muted">{d.shortAnswer.split('. ').slice(0, 2).join('. ')}.</p>
					</a>
				))}
			</div>
		</section>

		<section class="mb-16">
			<p class="text-accent font-semibold text-xs uppercase tracking-widest mb-2">On your side of the table</p>
			<h2 class="font-display text-2xl font-bold text-primary mb-4">What I actually do on a deal</h2>
			<ul class="space-y-4 list-none pl-0">
				<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">Find out which completed homes have been standing longest in the communities you like, and what each has already been reduced by. That list is not published anywhere.</li>
				<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">Ask whether a broker bonus is posted on a specific home and whether it can be redirected to you as a closing cost contribution. It is advertised to agents, not to buyers.</li>
				<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">Work out whether the buydown on offer is permanent or temporary, and price the builder's tied loan against an outside quote on all-in cost rather than the advertised rate.</li>
				<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">Get the effective tax rate for the specific phase, including any MUD or PID, so a "cheaper" home is not actually the more expensive one every month.</li>
				<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">Time the conversation to the builder's quarter end rather than to your weekend, which is the cheapest leverage available and costs you nothing.</li>
			</ul>
			<p class="text-sm text-text-muted mt-6 leading-relaxed">On new construction the builder pays my fee in most cases, disclosed in writing before we tour, so none of this costs you anything. Register me before your first visit to a sales office — walking in alone can cost you representation at that community entirely.</p>
		</section>

		<section class="mb-16">
			<h2 class="font-display text-2xl font-bold text-primary mb-6">Deals by area</h2>
			<p class="text-text-muted text-sm mb-4">Builders, communities, schools and the tax reality in each suburb I cover.</p>
			<div class="flex flex-wrap gap-2">
				{CITIES.map((c) => (
					<a href={`/new-construction/${c.slug}/`} class="text-sm text-primary bg-surface border border-border rounded-lg px-3 py-2 no-underline hover:border-accent transition-colors">{c.name}</a>
				))}
			</div>
		</section>

		<section class="mb-16">
			<h2 class="font-display text-2xl font-bold text-primary mb-8">Austin new construction deals, answered</h2>
			<div class="space-y-4">
				{faqs.map((f, i) => (
					<details class="bg-surface rounded-xl border border-border p-6 group" open={i === 0}>
						<summary class="font-display font-semibold text-primary cursor-pointer list-none flex items-center justify-between gap-4">
							{f.question}
							<span class="text-text-muted group-open:rotate-180 transition-transform flex-shrink-0">&#9662;</span>
						</summary>
						<p class="mt-3 text-text-muted text-sm leading-relaxed">{f.answer}</p>
					</details>
				))}
			</div>
		</section>

		<div class="bg-primary rounded-2xl p-8 sm:p-10 mb-10 text-center text-white">
			<h2 class="font-display text-2xl font-bold mb-3">Tell me your budget. I'll find what's actually discounted.</h2>
			<p class="text-white/70 mb-6 max-w-lg mx-auto">I call the builders, find the homes under real pressure, and send you the short list — including the concessions that are never advertised.</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="#schedule" class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-primary bg-white rounded-lg hover:bg-white/90 transition-all no-underline">Book a call</a>
				<a href={`tel:${PHONE.replace(/[^0-9+]/g, '')}`} class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white border-2 border-white/30 rounded-lg hover:bg-white/10 transition-all no-underline">Call {PHONE}</a>
			</div>
		</div>

		<div id="schedule" class="mb-10 scroll-mt-20">
			<TidyCalEmbed
				heading="Find out what is actually discounted"
				subheading="Pick a time. Tell me your budget and the areas you are considering, and I will come to the call with the homes that are genuinely under pressure right now."
			/>
		</div>

		<ContactForm heading="What are you looking for?" subheading="Budget, areas, and roughly when you need to be in. I'll send you the homes that are actually discounted rather than the ones that are advertised." />
	</div>
</BaseLayout>
