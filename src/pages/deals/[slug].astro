---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import ContactForm from '../../components/ContactForm.astro';
import TidyCalEmbed from '../../components/TidyCalEmbed.astro';
import IncentiveDisclosure from '../../components/IncentiveDisclosure.astro';
import { PHONE } from '../../consts';
import { DEAL_PAGES } from '../../data/deals';
import { CURRENT_OFFERS } from '../../data/current-offers';
import { BUILDERS } from '../../data/builders';

export async function getStaticPaths() {
	return DEAL_PAGES.map((deal) => ({ params: { slug: deal.slug }, props: { deal } }));
}

const { deal } = Astro.props;
const di = DEAL_PAGES.findIndex((d) => d.slug === deal.slug);
const siblings = [DEAL_PAGES[(di + 1) % DEAL_PAGES.length], DEAL_PAGES[(di + 2) % DEAL_PAGES.length]]
	.filter((d) => d.slug !== deal.slug);

const title = `${deal.title} | 512 Austin Home`;
const description = deal.shortAnswer.length > 155 ? `${deal.shortAnswer.slice(0, 152)}...` : deal.shortAnswer;
const updatedLabel = new Date(`${deal.contentUpdated}T12:00:00Z`).toLocaleDateString('en-US', {
	year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description}>
	<SchemaMarkup type="agent" />
	<SchemaMarkup type="faq" data={{ questions: deal.faqs }} />
	<SchemaMarkup type="breadcrumb" data={{ items: [
		{ name: 'Home', url: '/' },
		{ name: 'Deals', url: '/deals/' },
		{ name: deal.title, url: `/deals/${deal.slug}/` },
	] }} />

	<div class="max-w-3xl mx-auto px-5 sm:px-8 py-16">
		<header class="mb-8">
			<p class="text-sm uppercase tracking-widest text-text-muted mb-3">Austin new construction deals</p>
			<h1 class="font-display text-3xl sm:text-5xl font-bold text-primary tracking-tight mb-4">{deal.title}</h1>
			<p class="text-lg text-text-muted">{deal.subtitle}</p>
		</header>

		<section class="mb-10">
			<p class="text-accent font-semibold text-xs uppercase tracking-widest mb-3">The short answer</p>
			<p class="text-lg text-primary leading-relaxed">{deal.shortAnswer}</p>
		</section>

		<IncentiveDisclosure />

		<section class="mb-12">
			<h2 class="font-display text-2xl font-bold text-primary mb-4">Where the discount actually comes from</h2>
			<ul class="space-y-4 list-none pl-0">
				{deal.whereItComesFrom.map((i) => (
					<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">{i}</li>
				))}
			</ul>
		</section>

		<section class="mb-12">
			<h2 class="font-display text-2xl font-bold text-primary mb-4">How to tell a real deal from a marketed one</h2>
			<ul class="space-y-4 list-none pl-0">
				{deal.howToSpot.map((i) => (
					<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">{i}</li>
				))}
			</ul>
		</section>

		<section class="mb-12">
			<h2 class="font-display text-2xl font-bold text-primary mb-4">What to watch for</h2>
			<ul class="space-y-3 list-none pl-0">
				{deal.watchFor.map((i) => (
					<li class="text-sm text-text-muted leading-relaxed">{i}</li>
				))}
			</ul>
		</section>

		{CURRENT_OFFERS.length > 0 && (
			<section class="mb-12">
				<h2 class="font-display text-2xl font-bold text-primary mb-6">What is on the table right now</h2>
				<div class="space-y-4">
					{CURRENT_OFFERS.map((o) => {
						const b = BUILDERS.find((x) => x.slug === o.builderSlug);
						return (
							<div class="bg-surface border border-border rounded-xl p-6">
								{b && <a href={`/incentives/${b.slug}/`} class="font-display text-base font-bold text-accent no-underline hover:underline">{b.name}</a>}
								<p class="font-display text-lg font-bold text-primary mt-1 mb-2">{o.headline}</p>
								{o.detail && <p class="text-sm text-text-muted leading-relaxed mb-3">{o.detail}</p>}
								<p class="text-xs text-text-muted">Confirmed {o.verifiedOn} · {o.source}</p>
							</div>
						);
					})}
				</div>
			</section>
		)}

		<section class="mb-16">
			<h2 class="font-display text-2xl font-bold text-primary mb-8">Answered</h2>
			<div class="space-y-4">
				{deal.faqs.map((f, i) => (
					<details class="bg-surface rounded-xl border border-border p-6 group" open={i === 0}>
						<summary class="font-display font-semibold text-primary cursor-pointer list-none flex items-center justify-between gap-4">
							{f.question}
							<span class="text-text-muted group-open:rotate-180 transition-transform flex-shrink-0">&#9662;</span>
						</summary>
						<p class="mt-3 text-text-muted text-sm leading-relaxed">{f.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section class="mb-16">
			<h2 class="font-display text-2xl font-bold text-primary mb-6">Keep exploring</h2>
			<div class="grid sm:grid-cols-2 gap-4">
				<a href="/deals/" class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
					<span class="font-display font-bold text-primary block mb-1">All Austin new construction deals</span>
					<span class="text-sm text-text-muted">Where the discounts are and how to find them.</span>
				</a>
				{siblings.map((d) => (
					<a href={`/deals/${d.slug}/`} class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
						<span class="font-display font-bold text-primary block mb-1">{d.title}</span>
						<span class="text-sm text-text-muted">{d.subtitle}</span>
					</a>
				))}
				<a href="/incentives/" class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
					<span class="font-display font-bold text-primary block mb-1">What each incentive is worth</span>
					<span class="text-sm text-text-muted">Buydowns, credits, allowances, bonuses — and the catch in each.</span>
				</a>
				<a href="/guides/how-to-negotiate-with-an-austin-builder/" class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
					<span class="font-display font-bold text-primary block mb-1">How to negotiate with a builder</span>
					<span class="text-sm text-text-muted">What moves, what never does, and when to ask.</span>
				</a>
			</div>
		</section>

		<div class="bg-primary rounded-2xl p-8 sm:p-10 mb-10 text-center text-white">
			<h2 class="font-display text-2xl font-bold mb-3">Want to know what is actually discounted this week?</h2>
			<p class="text-white/70 mb-6 max-w-lg mx-auto">Tell me your budget and the areas you are considering. I will call the builders, find out which homes are under real pressure, and send you the short list.</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="#schedule" class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-primary bg-white rounded-lg hover:bg-white/90 transition-all no-underline">Book a call</a>
				<a href={`tel:${PHONE.replace(/[^0-9+]/g, '')}`} class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white border-2 border-white/30 rounded-lg hover:bg-white/10 transition-all no-underline">Call {PHONE}</a>
			</div>
		</div>

		<div id="schedule" class="mb-10 scroll-mt-20">
			<TidyCalEmbed
				heading="Find out what is actually discounted"
				subheading="Pick a time. Tell me your budget and the areas you are considering, and I will come to the call with the homes that are genuinely under pressure right now."
			/>
		</div>

		<ContactForm heading="What are you looking for?" subheading="Budget, areas, and roughly when you need to be in. I'll send you the homes that are actually discounted rather than the ones that are advertised." />

		<p class="text-xs text-text-muted text-center mt-10">Reviewed and updated {updatedLabel}. Builder incentives change constantly — contact me for current terms.</p>
	</div>
</BaseLayout>
