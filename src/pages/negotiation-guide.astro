---
// Delivery page for the "new home builder negotiation guide" lead magnet
// (IncentivesInline.astro with offer="guide"). noindex via LandingLayout.
//
// The PDF at /downloads/austin-builder-negotiation-guide.pdf is printed from this
// page, so the two never drift: edit the data files, then run
// scripts/build-negotiation-guide-pdf.sh. Everything below is pulled from
// src/data (guides, incentive types, builder negotiating notes), which is already
// written to the site's compliance rules: business practice only, no contract
// interpretation, no commission data, no current offers.
import LandingLayout from '../layouts/LandingLayout.astro';
import { PHONE, EMAIL, TIDYCAL_URL, BROKERAGE, TREC_LICENSE, SMS_BRAND } from '../consts';
import { findGuide } from '../data/guides';
import { INCENTIVE_TYPES } from '../data/incentives';
import { BUILDERS } from '../data/builders';

const GUIDE_UPDATED = '2026-11-04';
const PDF_PATH = '/downloads/austin-builder-negotiation-guide.pdf';

const negotiate = findGuide('how-to-negotiate-with-an-austin-builder')!;
const firstVisit = findGuide('before-your-first-builder-visit')!;
const questions = findGuide('questions-to-ask-an-austin-builder')!;
// The first-visit checklist covers registration in full, so skip the short version here.
const negotiateSections = negotiate.sections.filter((s) => !/^Register your agent/.test(s.heading));
const builders = [...BUILDERS].sort((a, b) => a.name.localeCompare(b.name));

const telHref = `tel:${PHONE.replace(/[^0-9+]/g, '')}`;
const smsHref = `sms:${PHONE.replace(/[^0-9+]/g, '')}`;
const updated = new Date(`${GUIDE_UPDATED}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<LandingLayout
	title="The Austin New Home Builder Negotiation Guide | 512 Austin Home"
	description="What Austin builders will move on, what they won't, the questions to ask, and builder-by-builder negotiating notes."
	canonical="https://512austinhome.com/negotiation-guide/"
>
	<div class="guide max-w-3xl mx-auto px-5 sm:px-8 py-10 sm:py-14">
		<div class="no-print bg-accent-light rounded-2xl p-6 sm:p-8 border-l-4 border-accent mb-12">
			<p class="font-display text-lg font-bold text-primary mb-2">Your guide is ready</p>
			<p class="text-sm text-text-muted mb-4">Read it below, or save the PDF to read later or share with whoever you're buying with.</p>
			<a href={PDF_PATH} download class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-accent rounded-lg hover:bg-accent-hover transition-all no-underline">Download the PDF</a>
		</div>

		<div class="cover">
			<p class="text-accent font-semibold text-xs uppercase tracking-widest mb-3">512 Austin Home</p>
			<h1 class="font-display text-3xl sm:text-5xl font-bold text-primary tracking-tight mb-4">The Austin New Home Builder Negotiation Guide</h1>
			<p class="text-lg text-text-muted mb-6">What builders will move on, what they won't, the questions to ask, and how each Austin builder actually negotiates.</p>
			<p class="text-sm text-text-muted">By William Zhang, Austin Realtor · {BROKERAGE} · TREC #{TREC_LICENSE} · Updated {updated}</p>
		</div>

		<section class="block-section">
			<p class="text-accent font-semibold text-xs uppercase tracking-widest mb-3">The short answer</p>
			<p class="text-lg text-primary leading-relaxed">{negotiate.shortAnswer}</p>
		</section>

		{negotiateSections.map((s) => (
			<section class="block-section">
				<h2 class="font-display text-2xl font-bold text-primary mb-4">{s.heading}</h2>
				{s.body.map((p) => <p class="text-text-muted leading-relaxed mb-4">{p}</p>)}
				{s.list && (
					<ul class="space-y-3 list-none pl-0 mt-4">
						{s.list.map((item) => <li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">{item}</li>)}
					</ul>
				)}
			</section>
		))}

		<section class="block-section">
			<h2 class="font-display text-2xl font-bold text-primary mb-2">What each incentive is really worth</h2>
			<p class="text-text-muted text-sm mb-6">Builders advertise these in nearly the same words. They are worth very different amounts.</p>
			<div class="space-y-5">
				{INCENTIVE_TYPES.map((t) => (
					<div class="card bg-surface border border-border rounded-xl p-5">
						<h3 class="font-display text-lg font-bold text-primary mb-2">{t.name}</h3>
						<p class="text-sm text-text-muted leading-relaxed mb-3">{t.what}</p>
						<p class="text-xs uppercase tracking-wider text-text-muted mb-1">What it is worth to you</p>
						<p class="text-sm text-text-muted leading-relaxed mb-3">{t.worth}</p>
						<p class="text-xs uppercase tracking-wider text-accent mb-1">The catch</p>
						<p class="text-sm text-text-muted leading-relaxed">{t.catch}</p>
					</div>
				))}
			</div>
		</section>

		<section class="block-section">
			<h2 class="font-display text-2xl font-bold text-primary mb-2">Before your first sales office visit</h2>
			<p class="text-text-muted text-sm mb-6">{firstVisit.shortAnswer}</p>
			{firstVisit.sections.map((s) => (
				<div class="mb-8">
					<h3 class="font-display text-lg font-bold text-primary mb-3">{s.heading}</h3>
					{s.body.map((p) => <p class="text-sm text-text-muted leading-relaxed mb-3">{p}</p>)}
					{s.list && (
						<ul class="checklist space-y-2 list-none pl-0">
							{s.list.map((item) => <li class="text-sm text-text-muted leading-relaxed">{item}</li>)}
						</ul>
					)}
				</div>
			))}
		</section>

		<section class="block-section">
			<h2 class="font-display text-2xl font-bold text-primary mb-6">Questions to ask the builder</h2>
			{questions.sections.map((s) => (
				<div class="mb-8">
					<h3 class="font-display text-lg font-bold text-primary mb-3">{s.heading}</h3>
					{s.body.map((p) => <p class="text-sm text-text-muted leading-relaxed mb-3">{p}</p>)}
					{s.list && (
						<ul class="checklist space-y-2 list-none pl-0">
							{s.list.map((item) => <li class="text-sm text-text-muted leading-relaxed">{item}</li>)}
						</ul>
					)}
				</div>
			))}
		</section>

		<section class="block-section page-break">
			<h2 class="font-display text-2xl font-bold text-primary mb-2">Builder by builder</h2>
			<p class="text-text-muted text-sm mb-6">How each Austin builder tends to negotiate. Where I have closed or negotiated with a builder myself, it says so.</p>
			<div class="space-y-5">
				{builders.map((b) => (
					<div class="card bg-surface border border-border rounded-xl p-5">
						<div class="flex flex-wrap items-baseline justify-between gap-x-3 mb-1">
							<h3 class="font-display text-lg font-bold text-primary">{b.name}</h3>
							<span class="text-xs text-text-muted">{b.segment} · {b.priceRange}</span>
						</div>
						{b.firstHand && <p class="text-xs font-semibold text-accent mb-2">I have closed or negotiated with {b.name}.</p>}
						<ul class="space-y-2 list-none pl-0 mt-2">
							{b.negotiating.map((n) => <li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-3">{n}</li>)}
						</ul>
					</div>
				))}
			</div>
		</section>

		<div class="card bg-surface border border-border rounded-xl p-5 mb-12">
			<p class="text-sm text-text-muted leading-relaxed"><strong class="text-primary">I am a licensed Texas real estate agent, not an attorney.</strong> Nothing here is legal advice, and I do not interpret builder contracts, addenda or warranty terms. That is a real estate attorney's job. What I can do is represent you through the negotiation, the inspection and the walkthrough, and tell you when something belongs in front of a lawyer.</p>
		</div>

		<section class="card cta bg-primary rounded-2xl p-8 text-white">
			<h2 class="font-display text-2xl font-bold mb-3">Text me before your first visit</h2>
			<p class="text-white/80 mb-6">Send me the builder and the community you're looking at. I'll get you registered and tell you what I'd ask for on that home.</p>
			<div class="no-print flex flex-col sm:flex-row gap-3">
				<a href={smsHref} class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-primary bg-white rounded-lg hover:bg-white/90 transition-all no-underline">Text me</a>
				<a href={telHref} class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white border-2 border-white/30 rounded-lg hover:bg-white/10 transition-all no-underline">Call {PHONE}</a>
				<a href={TIDYCAL_URL} target="_blank" rel="noopener" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white border-2 border-white/30 rounded-lg hover:bg-white/10 transition-all no-underline">Book a call</a>
			</div>
			<p class="print-only text-white/90 text-sm leading-relaxed">William Zhang · Text or call {PHONE} · {EMAIL} · 512austinhome.com</p>
		</section>

		<p class="print-only text-xs text-text-muted mt-8">William Zhang | {SMS_BRAND}, brokered by {BROKERAGE} | TREC #{TREC_LICENSE}. Builder practices and incentive programs change often. Confirm current terms with the builder before making decisions.</p>
	</div>
</LandingLayout>

<style>
	.block-section { margin-bottom: 3rem; }
	.checklist li { position: relative; padding-left: 1.6rem; }
	.checklist li::before { content: ''; position: absolute; left: 0; top: 0.2rem; width: 0.9rem; height: 0.9rem; border: 1.5px solid #2563eb; border-radius: 0.2rem; }
	.print-only { display: none; }

	@media print {
		@page { size: Letter; margin: 0.6in 0.65in; }
		.print-only { display: block; }
		.no-print { display: none !important; }
		.guide { padding: 0 !important; max-width: none !important; }
		.cover { padding: 1.5in 0 1in; border-bottom: 3px solid #2563eb; margin-bottom: 2.5rem; }
		.page-break { break-before: page; }
		.card, .checklist li, li { break-inside: avoid; }
		h2, h3 { break-after: avoid; }
		.block-section { margin-bottom: 2rem; }
		.cta { -webkit-print-color-adjust: exact; print-color-adjust: exact; break-inside: avoid; }
	}
</style>

<style is:global>
	@media print {
		body > header, body > footer { display: none !important; }
		body { background: #fff !important; }
	}
</style>
