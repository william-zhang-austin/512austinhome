---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import ContactForm from '../../components/ContactForm.astro';
import { GUIDES } from '../../data/guides';

export async function getStaticPaths() {
	return GUIDES.map((guide) => ({
		params: { slug: guide.slug },
		props: { guide },
	}));
}

const { guide } = Astro.props;

const title = `${guide.title} | 512 Austin Home`;
const description = guide.shortAnswer.length > 155 ? `${guide.shortAnswer.slice(0, 152)}...` : guide.shortAnswer;

const updatedLabel = new Date(`${guide.contentUpdated}T12:00:00Z`).toLocaleDateString('en-US', {
	year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description}>
	<SchemaMarkup type="agent" />
	<SchemaMarkup type="faq" data={{ questions: guide.faqs }} />
	<SchemaMarkup type="breadcrumb" data={{ items: [
		{ name: 'Home', url: '/' },
		{ name: 'Guides', url: '/guides/' },
		{ name: guide.title, url: `/guides/${guide.slug}/` },
	] }} />
	<SchemaMarkup type="article" data={{
		title: guide.title,
		description: guide.shortAnswer,
		pubDate: guide.contentUpdated,
		updatedDate: guide.contentUpdated,
		url: `/guides/${guide.slug}/`,
	}} />

	<div class="max-w-3xl mx-auto px-5 sm:px-8 py-16">
		<header class="mb-8">
			<p class="text-sm uppercase tracking-widest text-text-muted mb-3">Buyer's guide</p>
			<h1 class="font-display text-3xl sm:text-5xl font-bold text-primary tracking-tight mb-4">{guide.title}</h1>
			<p class="text-lg text-text-muted">{guide.subtitle}</p>
		</header>

		<section class="mb-12">
			<p class="text-accent font-semibold text-xs uppercase tracking-widest mb-3">The short answer</p>
			<p class="text-lg text-primary leading-relaxed">{guide.shortAnswer}</p>
		</section>

		{guide.sections.map((s) => (
			<section class="mb-12">
				<h2 class="font-display text-2xl font-bold text-primary mb-4">{s.heading}</h2>
				{s.body.map((para) => (
					<p class="text-text-muted leading-relaxed mb-4">{para}</p>
				))}
				{s.list && (
					<ul class="space-y-3 list-none pl-0 mt-4">
						{s.list.map((item) => (
							<li class="text-sm text-text-muted leading-relaxed border-l-2 border-accent pl-4">{item}</li>
						))}
					</ul>
				)}
			</section>
		))}

		<div class="bg-surface border border-border rounded-xl p-5 mb-12">
			<p class="text-sm text-text-muted leading-relaxed">General information drawn from transactions I have worked, not legal advice. Builder contracts and warranty terms differ and change — have your own agent read the documents for your specific deal.</p>
		</div>

		<section class="mb-16">
			<h2 class="font-display text-2xl font-bold text-primary mb-8">Answered</h2>
			<div class="space-y-4">
				{guide.faqs.map((f, i) => (
					<details class="bg-surface rounded-xl border border-border p-6 group" open={i === 0}>
						<summary class="font-display font-semibold text-primary cursor-pointer list-none flex items-center justify-between gap-4">
							{f.question}
							<span class="text-text-muted group-open:rotate-180 transition-transform flex-shrink-0">&#9662;</span>
						</summary>
						<p class="mt-3 text-text-muted text-sm leading-relaxed">{f.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section class="mb-16">
			<h2 class="font-display text-2xl font-bold text-primary mb-6">Keep exploring</h2>
			<div class="grid sm:grid-cols-2 gap-4">
				<a href="/guides/" class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
					<span class="font-display font-bold text-primary block mb-1">All buyer guides</span>
					<span class="text-sm text-text-muted">Contracts, inspections, warranties, financing.</span>
				</a>
				{(guide.related || []).map((r) => (
					<a href={r.href} class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
						<span class="font-display font-bold text-primary block mb-1">{r.label}</span>
						<span class="text-sm text-text-muted">Related reading.</span>
					</a>
				))}
				<a href="/new-construction/" class="block bg-surface border border-border rounded-xl p-5 no-underline hover:border-accent transition-colors">
					<span class="font-display font-bold text-primary block mb-1">New construction by city</span>
					<span class="text-sm text-text-muted">Builders, schools, taxes and tradeoffs.</span>
				</a>
			</div>
		</section>

		<ContactForm heading="Question this guide did not answer?" subheading="Tell me what you're looking at and where you are in the process. I'll give you a straight answer." />

		<p class="text-xs text-text-muted text-center mt-10">Reviewed and updated {updatedLabel}.</p>
	</div>
</BaseLayout>
