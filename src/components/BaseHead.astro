---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	canonical?: string;
	type?: string;
}

const canonicalURL = Astro.props.canonical
	? new URL(Astro.props.canonical)
	: new URL(Astro.url.pathname, Astro.site);

const { title: rawTitle, description: rawDescription, image, type = 'website' } = Astro.props;

// Keep titles inside Google's ~60-character display: the brand suffix is the
// first thing to go, since the domain already shows beside every result.
const SUFFIX = ' | 512 Austin Home';
const title = rawTitle.length > 60 && rawTitle.endsWith(SUFFIX) ? rawTitle.slice(0, -SUFFIX.length) : rawTitle;

// Keep meta descriptions within Bing's and Google's display: cut at the last
// full sentence that fits, else at the last clause boundary, and always end on
// a period rather than a mid-sentence "...".
// 150, not 160: Bing's checker flags descriptions near 160, and counts
// multi-byte characters (dashes, ellipses) as more than one.
// The lookbehind keeps abbreviations like "D.R. Horton" from reading as a
// sentence end.
const SENTENCE_END = /(?<!\b(?:D\.R|Dr|St|Mr|Mrs|Ms|Jr|vs|U\.S|No))[.?!](?=\s|$)/g;
function trimDescription(raw: string, max = 150) {
	const d = raw.replace(/(\d[\dKkM,.%+]*)\s*[—–]\s*(\$?\d)/g, '$1 to $2').replace(/\s*[—–]\s*/g, ', ').replace(/…/g, '...').trim();
	if (d.length <= max) return d;
	const head = d.slice(0, max + 1);
	let sentenceEnd = -1;
	for (const m of head.matchAll(SENTENCE_END)) if (m.index! < max) sentenceEnd = m.index!;
	if (sentenceEnd >= 70) return head.slice(0, sentenceEnd + 1);
	const clause = Math.max(head.lastIndexOf(', ', max - 1), head.lastIndexOf('; ', max - 1), head.lastIndexOf(': ', max - 1));
	const cut = clause >= 90 ? clause : head.lastIndexOf(' ', max - 1);
	return head.slice(0, cut).replace(/[\s,;:\-]+(and|or|the|a|an|of|to|for|with|from|in|on)?$/i, '').replace(/[,;:\-]+$/, '') + '.';
}
const description = trimDescription(rawDescription);
const ogImage = image || new URL('/og-default.jpg', Astro.site).href;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=Plus+Jakarta+Sans:wght@500..800&display=swap" rel="stylesheet" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="William Zhang" />
<meta name="publisher" content="512 Austin Home" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="512 Austin Home" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{type === 'article' && <meta property="article:author" content="William Zhang" />}
{type === 'article' && <meta property="article:publisher" content="https://512austinhome.com" />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- Privacy-friendly analytics by Plausible -->
<script is:inline async src="https://plausible.io/js/pa-OaYtCB0WlOngL9rgiyxwV.js"></script>
<script is:inline>
	window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
	plausible.init()
</script>
<script is:inline>
	// Plausible goals: phone, email, home-search clicks, and Tally contact form sends
	document.addEventListener('click', function (e) {
		var a = e.target.closest && e.target.closest('a[href]');
		if (!a) return;
		var h = a.getAttribute('href') || '';
		if (h.indexOf('tel:') === 0) plausible('Phone Click');
		else if (h.indexOf('mailto:') === 0) plausible('Email Click');
		else if (/nhb\.app|lifeinaustintx\.com/.test(a.hostname)) plausible('Home Search Click', { props: { destination: a.hostname } });
	});
	window.addEventListener('message', function (e) {
		if (e.origin !== 'https://tally.so') return;
		try {
			var d = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
			if (d && d.event === 'Tally.FormSubmitted') plausible('Contact Form Submit');
		} catch (_) {}
	});
</script>
