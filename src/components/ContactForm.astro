---
interface Props {
	heading?: string;
	subheading?: string;
	formId?: string;
}

const {
	heading = 'Get in Touch',
	subheading = 'Whether you\'re buying, selling, or just exploring — I\'m here to help.',
	formId = 'RGBKxQ',
} = Astro.props;

const embedSrc = `https://tally.so/embed/${formId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;
---

<section id="contact" class="bg-warm-dark rounded-2xl p-6 sm:p-10">
	<h2 class="font-display text-2xl font-bold text-primary mb-2">{heading}</h2>
	<p class="text-text-muted mb-6">{subheading}</p>

	<iframe
		data-tally-src={embedSrc}
		loading="lazy"
		width="100%"
		height="500"
		frameborder="0"
		marginheight="0"
		marginwidth="0"
		title={heading}
		class="w-full block"
	></iframe>

	<script is:inline>
		// Load Tally's widget script only when a form gets near the viewport, so
		// pages don't pay for ~200 KB of third-party JS on first paint. If the
		// script fails or is slow, set the iframe src directly so the form loads.
		(function () {
			if (window.__tallyLazy) return;
			window.__tallyLazy = true;
			var started = false;
			function fallback() {
				document.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(function (el) {
					el.src = el.getAttribute('data-tally-src');
				});
			}
			function go() {
				if (started) return;
				started = true;
				var s = document.createElement('script');
				s.src = 'https://tally.so/widgets/embed.js';
				s.async = true;
				s.onload = function () { if (window.Tally) window.Tally.loadEmbeds(); };
				s.onerror = fallback;
				document.head.appendChild(s);
				setTimeout(fallback, 4000);
			}
			function init() {
				var els = document.querySelectorAll('iframe[data-tally-src]');
				if (!('IntersectionObserver' in window)) return go();
				// Backstop: a jump past the embed (anchor link, End key) never
				// intersects, so the first scroll loads it too.
				window.addEventListener('scroll', go, { once: true, passive: true });
				var io = new IntersectionObserver(function (entries) {
					if (entries.some(function (e) { return e.isIntersecting; })) { io.disconnect(); go(); }
				}, { rootMargin: '600px 0px' });
				els.forEach(function (el) { io.observe(el); });
			}
			if (document.readyState !== 'loading') init();
			else document.addEventListener('DOMContentLoaded', init);
		})();
	</script>
</section>
